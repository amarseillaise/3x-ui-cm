# Copy to the repository root as .env and fill in. Never commit .env.

# --- 3x-ui master panel -------------------------------------------------------
# Panel root URL including the web base path, with trailing slash.
NODE_URL=https://panel.example.com:2053/secret-base-path/
# Settings -> Security -> API Token. Full-admin credential: treat like the panel password.
NODE_API_TOKEN=
# Set to 1 only if the panel uses a self-signed certificate.
NODE_TLS_INSECURE=0

# --- This app -----------------------------------------------------------------
# Public URL of the cabinet (used in magic links and push payloads).
APP_BASE_URL=https://cab.example.com
# Domain for the optional Caddy profile (same host as APP_BASE_URL).
APP_DOMAIN=cab.example.com
# Optional: subscription link base. Leave empty to read subPath/subDomain/subPort from the panel.
SUB_BASE_URL=

# Generate with: make gen-secrets
ADMIN_TOKEN=
ADMIN_LINK_SECRET=
SESSION_SECRET=

# Web Push. Generate with: go run ./cmd/server gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Runtime (defaults shown) -------------------------------------------------
# DB_PATH=/data/app.db
# CONFIG_PATH=/data/config.yaml
# LISTEN_ADDR=:8080
# TRUST_PROXY=1            # client IP from X-Forwarded-For (app sits behind Caddy/nginx)
# POLL_INTERVAL=10m
# NOTIFY_DAYS=7,3,1
# NOTIFY_TRAFFIC_PCT=90
# LOG_LEVEL=info
