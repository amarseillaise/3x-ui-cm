# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/
# App runtime data and local config (contains payment requisites)
/data/
/config.yaml
*.db
*.db-wal
*.db-shm

# Frontend
web/node_modules/
web/dist/
internal/webdist/dist/*
!internal/webdist/dist/.gitkeep

# Local tools (portable Node, see make tools-node)
/.tools/

# SQLite backups
/backups/

# Rendered panel template (make sub-template)
/sub_template/

# Rendered nginx server block (make nginx-config)
/deploy/nginx/

# macOS
.DS_Store
