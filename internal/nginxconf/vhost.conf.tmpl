# Generated by "server nginx-config" from APP_BASE_URL. Do not edit here:
# change .env and run `make nginx-config`, then deploy/install-nginx.sh.
#
# The cabinet itself listens on {{ .Upstream }} and speaks plain HTTP;
# TLS ends in this block.

server {
    listen {{ .Port }} ssl http2;
    listen [::]:{{ .Port }} ssl http2;
    server_name {{ .ServerName }};

    ssl_certificate     {{ .CertFile }};
    ssl_certificate_key {{ .KeyFile }};

    # The PWA bundle is the bulk of the traffic and compresses well.
    gzip             on;
    gzip_min_length  1024;
    gzip_proxied     any;
    gzip_types       text/plain text/css application/javascript application/json
                     image/svg+xml application/manifest+json;

    client_max_body_size 1m;

    location / {
        proxy_pass         http://{{ .Upstream }};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
{{ if .RedirectHTTP }}
server {
    listen 80;
    listen [::]:80;
    server_name {{ .ServerName }};
    return 301 https://$host{{ if ne .Port 443 }}:{{ .Port }}{{ end }}$request_uri;
}
{{ end }}
